NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:8080
TRUST_PROXY_HOPS=0
MONGODB_URI=mongodb://127.0.0.1:27017/campusfind
MONGODB_DB=campusfind
UPLOAD_DIR=uploads
# Set a unique random value of at least 32 characters before enabling authentication.
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7
# Comma-separated allowed domains, for example: college.edu
COLLEGE_EMAIL_DOMAINS=
EMAIL_VERIFICATION_REQUIRED=false
# Required to send verification messages when EMAIL_VERIFICATION_REQUIRED=true.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
